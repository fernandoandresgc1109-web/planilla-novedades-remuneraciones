DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=planilla_novedades
DB_USER=planilla_app
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Seguridad para producción con HTTPS:
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.example
# DJANGO_TRUST_X_FORWARDED_PROTO=True
# Render proporciona automáticamente estas variables:
# DATABASE_URL=postgresql://usuario:contrasena@servidor:5432/base_de_datos
# RENDER_EXTERNAL_HOSTNAME=tu-aplicacion.onrender.com

# Administrador inicial solicitado al crear el Blueprint:
# DJANGO_SUPERUSER_USERNAME=admin_planilla
# DJANGO_SUPERUSER_EMAIL=correo@example.com
# DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
