  "bugs": {
    "url": "https://github.com/fernandoandresgc1109-web/planilla-novedades-remuneraciones/issues"
  },
  "homepage": "https://github.com/fernandoandresgc1109-web/planilla-novedades-remuneraciones#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}